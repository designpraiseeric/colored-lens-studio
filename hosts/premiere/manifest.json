{
  "manifestVersion": 5,
  "id": "com.designpraise.coloredlens",
  "name": "Colored Lens",
  "version": "0.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": [
        "https"
      ],
      "extensions": [
        ".pkg",
        ".exe",
        ".ccx"
      ]
    },
    "ipc": {
      "enablePluginCommunication": true
    },
    "clipboard": "readAndWrite"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "coloredlens",
      "label": {
        "default": "Colored Lens"
      },
      "minimumSize": {
        "width": 300,
        "height": 400
      },
      "maximumSize": {
        "width": 2000,
        "height": 4000
      },
      "preferredDockedSize": {
        "width": 380,
        "height": 700
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 760
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-dark.svg",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-light.svg",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ]
        }
      ]
    },
    {
      "type": "panel",
      "id": "preview",
      "label": {
        "default": "Colored Lens Preview"
      },
      "minimumSize": {
        "width": 200,
        "height": 150
      },
      "maximumSize": {
        "width": 4000,
        "height": 4000
      },
      "preferredDockedSize": {
        "width": 480,
        "height": 360
      },
      "preferredFloatingSize": {
        "width": 560,
        "height": 420
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-dark.svg",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-light.svg",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.svg",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ]
}
