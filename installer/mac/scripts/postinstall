#!/bin/bash
# Colored Lens Studio postinstall (runs as root after the files are copied).
LOG=/tmp/ColoredLensStudio-install.log
exec >>"$LOG" 2>&1
echo "== $(date) postinstall"
SUPPORT="/Library/Application Support/ColoredLens"

# 1. A LUT folder Resolve lists and the panel can write to without admin rights.
LUTDIR="/Library/Application Support/Blackmagic Design/DaVinci Resolve/LUT/ColoredLens"
mkdir -p "$LUTDIR" && chmod 777 "$LUTDIR"

USER_NAME="$(stat -f%Su /dev/console)"; USER_ID="$(id -u "$USER_NAME" 2>/dev/null)"

# 2. The Colored Lens Helper: start it now for the logged-in user (it starts by itself at every login after this).
HELPER="$SUPPORT/ColoredLensHelper"; AGENT="/Library/LaunchAgents/com.designpraise.coloredlens.helper.plist"
chmod 755 "$HELPER" 2>/dev/null; chown root:wheel "$AGENT" 2>/dev/null; chmod 644 "$AGENT" 2>/dev/null
xattr -dr com.apple.quarantine "$HELPER" 2>/dev/null
if [ -n "$USER_ID" ] && [ "$USER_NAME" != "root" ]; then
  sudo -u "$USER_NAME" mkdir -p "/Users/$USER_NAME/Library/Application Support/ColoredLens/bridge"
  launchctl bootout "gui/$USER_ID/com.designpraise.coloredlens.helper" 2>/dev/null
  launchctl bootstrap "gui/$USER_ID" "$AGENT" && echo "helper started" || echo "helper will start at next login"
fi
# 3. The Premiere Pro panel: Adobe's own installer agent installs the .ccx for the logged-in user. That agent waits
# for the Creative Cloud app and can sit there for many minutes when it is closed, so it runs in the background
# and this installer does not wait for it. If it has not finished in 3 minutes, the .ccx is opened instead.
CCX="$(ls "$SUPPORT"/ColoredLens-Premiere-*.ccx 2>/dev/null | sort -V | tail -1)"
UPIA="/Library/Application Support/Adobe/Adobe Desktop Common/RemoteComponents/UPI/UnifiedPluginInstallerAgent/UnifiedPluginInstallerAgent.app/Contents/MacOS/UnifiedPluginInstallerAgent"
if [ -n "$CCX" ] && [ -n "$USER_ID" ] && [ "$USER_NAME" != "root" ]; then
  if [ -x "$UPIA" ]; then
    ( UOUT="$(mktemp)"; launchctl asuser "$USER_ID" sudo -u "$USER_NAME" "$UPIA" --install "$CCX" >"$UOUT" 2>&1 & PID=$!
      for i in $(seq 1 180); do kill -0 $PID 2>/dev/null || break; sleep 1; done
      if kill -0 $PID 2>/dev/null; then echo "UPIA still waiting after 3 minutes; opening the .ccx with Creative Cloud"; kill $PID 2>/dev/null; launchctl asuser "$USER_ID" sudo -u "$USER_NAME" open "$CCX"
      else wait $PID; RC=$?; cat "$UOUT"
        # the agent can print "Failed to install" and still exit 0
        if [ $RC -eq 0 ] && ! grep -qi "failed" "$UOUT"; then echo "Premiere panel installed with UPIA"
        else echo "UPIA failed; opening the .ccx with Creative Cloud"; launchctl asuser "$USER_ID" sudo -u "$USER_NAME" open "$CCX"; fi; fi
      rm -f "$UOUT"
    ) </dev/null >>"$LOG" 2>&1 &
    disown 2>/dev/null
  else echo "Creative Cloud installer agent not found; opening the .ccx"; launchctl asuser "$USER_ID" sudo -u "$USER_NAME" open "$CCX"; fi
fi

# 4. Resolve loads WorkflowIntegration.node from its own Developer folder (nothing to copy). Clear quarantine on our bundles.
xattr -dr com.apple.quarantine "/Library/OFX/Plugins/LukulukuLook.ofx.bundle" 2>/dev/null
xattr -dr com.apple.quarantine "/Library/Application Support/Adobe/Common/Plug-ins/7.0/MediaCore/LukulukuLook.plugin" 2>/dev/null
xattr -dr com.apple.quarantine "/Library/Application Support/Blackmagic Design/DaVinci Resolve/Workflow Integration Plugins/com.designpraise.coloredlens" 2>/dev/null
echo "done"
exit 0
